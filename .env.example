# ===========================================================================
# LetterDesk — serverless proxy environment template (api/search.js)
# ---------------------------------------------------------------------------
# Copy to `.env.local` for `vercel dev` / `netlify dev` ONLY.
# In production, set these in the hosting dashboard instead:
#   Vercel:   Project → Settings → Environment Variables  (or `vercel env add`)
#   Netlify:  Site configuration → Environment variables
# NEVER commit a real key and NEVER reference any *_API_KEY from client JS —
# the browser bundle must only ever call /api/search.
# ===========================================================================

# ---- Secrets (server-side only; each feature degrades gracefully without) --
GROQ_API_KEY=                       # https://console.groq.com/keys  (AI drafts)
OPENALEX_API_KEY=                   # optional, https://openalex.org/settings/api
OPENALEX_MAILTO=you@example.com     # polite-pool email for OpenAlex + Crossref
SEMANTIC_SCHOLAR_API_KEY=           # optional, raises S2 rate limit
HUNTER_API_KEY=                     # optional, email verification v2
ABSTRACT_API_KEY=                   # optional, email validation
ZEROBOUNCE_API_KEY=                 # optional, email validation

# ---- CORS allow-list (REQUIRED in production) ------------------------------
# Comma-separated EXACT origins of the deployed site. No wildcards; requests
# from any other origin receive no Access-Control-Allow-Origin header.
ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# ---- Rate limiting (per 60 s window) ---------------------------------------
RATE_LIMIT_PER_IP=30                # requests/min per client IP
RATE_LIMIT_PER_SESSION=60           # requests/min per X-Session-Id (browser tab)

# ---- Groq spending controls (global, across all users) ---------------------
GROQ_MAX_REQUESTS_PER_MIN=10        # hard cap on upstream calls per minute
GROQ_MAX_TOKENS_PER_HOUR=60000      # token/spend budget; alerts fire at 80%
                                    # (also enable Groq console usage alerts)
