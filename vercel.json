{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/search.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/_shared.js": {
      "exclude": true
    }
  },
  "functionsConfig": {
    "nodeVersion": "20.x"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
